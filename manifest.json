{
  "version": "3.4",
  "release_date": "2025-12-02",
  "architecture": "modular",
  "changelog": {
    "3.4": [
      "Fix Multi-Instance: credentials format đúng (n8n_inet<id>_<ip_sum>)",
      "Fix Multi-Instance: đợi PostgreSQL healthy trước khi khởi động N8N",
      "Fix Multi-Instance: kiểm tra N8N respond trước khi cấu hình Nginx",
      "Fix Multi-Instance: hiển thị logs nếu container không khởi động được"
    ],
    "3.3": [
      "Thêm tính năng Multi-Instance N8N (chạy nhiều instance trên 1 VPS)",
      "Tái cấu trúc menu: Multi-Instance (option 8), Gỡ cài đặt (option 9)",
      "Sửa lỗi PID syntax trong lock files ($ → $$)",
      "Thêm validation functions cho domain và env values",
      "Cải thiện race condition handling với postgres health checks",
      "Thêm log rotation mechanism để tránh đầy disk",
      "Cập nhật restart_manager với postgres query validation",
      "Fix Multi-Instance: tìm đúng container names từ docker-compose",
      "Fix Multi-Instance: SSL cài riêng không conflict với instance 1",
      "Fix Multi-Instance: hỗ trợ start từ docker-compose nếu container chưa tồn tại"
    ],
    "3.2": [
      "Fix hook.py regex patterns bị thiếu ký tự $ cuối (CRITICAL)",
      "Thống nhất ssl.sh sử dụng get_current_domain() thay vì biến global DOMAIN",
      "Thêm validation domain và email trong wrapper scripts",
      "Tập trung log files vào /var/log/n8npanel/ cho tất cả wrapper scripts",
      "Cải thiện error handling trong domain_change_wrapper.sh",
      "Cải thiện error handling trong ssl_install_wrapper.sh",
      "Cải thiện error handling trong nginx_config_wrapper.sh"
    ],
    "3.1": [
      "Fix hook.py bị lỗi cú pháp regex (CRITICAL)",
      "Sửa thứ tự source modules trong n8n.sh (ssl_manager trước nginx_manager)",
      "Thống nhất sử dụng get_current_domain() thay vì biến global DOMAIN",
      "Bỏ fallback restart, bắt buộc dùng restart_manager",
      "Sửa trap handlers trong wrapper scripts để tránh conflict",
      "Thêm retry mechanism cho download_remote_manifest",
      "Thêm health check query thực tế cho safe_restart_postgres",
      "Thêm validation email trong domain_manager",
      "Thêm validation domain trong ssl_manager",
      "Tập trung log files vào /var/log/n8npanel/",
      "Sử dụng biến môi trường thay vì hardcode paths"
    ],
    "3.0": [
      "Chuyển sang cấu trúc modular",
      "Thêm tính năng backup nâng cao với restore PostgreSQL",
      "Cải thiện quản lý SSL tự động",
      "Thêm tính năng quản lý N8N (reset user, MFA, LDAP, domain)",
      "Cải thiện hệ thống cập nhật thông minh"
    ]
  },
